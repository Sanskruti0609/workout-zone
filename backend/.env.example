# Port the API listens on
PORT=4000
NODE_ENV=development
# Origin allowed to call the API (your frontend URL)
FRONTEND_URL=http://localhost:5173
# Neon: pooled string for the app, direct string for migrations
DATABASE_URL=""
DIRECT_URL=""
# Secret used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""
# "lax" for local development. Use "none" only if the frontend and backend are on different domains in production.
COOKIE_SAMESITE=lax
# Admin login. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
# Where uploaded photos/videos are saved (optional). In production this must be a persistent disk.
UPLOAD_DIR=""
